# Copy to .env.local and fill in the secrets. Never commit .env.local.

# Meta Model API (https://dev.meta.ai)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
MODEL_SPARK=muse-spark-1.3
MODEL_SPARK_AUDIO=muse-spark-1.3
MODEL_WONDER=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0

# Supabase (Project Settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Live travel data (official MCP servers, no key needed)
KIWI_MCP_URL=https://mcp.kiwi.com
TRIVAGO_MCP_URL=https://mcp.trivago.com/mcp

# Bank Al-Maghrib reference rate, entered by hand (decimal point)
EUR_MAD_RATE=
EUR_MAD_DATE=

# App settings
DOTATION_MAD=100000
SPEND_LIMIT_USD=120
JURY_REPLAY_AFTER_MS=20000
NEXT_PUBLIC_SITE_URL=https://bonsafar.com
