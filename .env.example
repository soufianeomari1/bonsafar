# Copy to .env.local and fill in the secrets. Never commit .env.local.

# Meta Model API (https://dev.meta.ai)
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
MODEL_TRANSCRIBE=muse-voice-transcribe-1.0
MODEL_SPARK=muse-spark-1.3
MODEL_SPARK_AUDIO=muse-spark-1.3
MODEL_WONDER=muse-wonder-1.0
MODEL_IMAGE=muse-image-1.0

# Supabase (Project Settings > API keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Live travel data (official MCP servers, no key needed)
KIWI_MCP_URL=https://mcp.kiwi.com
TRIVAGO_MCP_URL=https://mcp.trivago.com/mcp

# Bank Al-Maghrib reference rate, entered by hand (decimal point)
EUR_MAD_RATE=
EUR_MAD_DATE=

# App settings
DOTATION_MAD=100000
SPEND_LIMIT_USD=120
NEXT_PUBLIC_SITE_URL=https://bonsafar.com

# Hidden judges' mode: open /jury?k=<key> once. Never commit the key.
JURY_ACCESS_KEY=
# Jury live run: switch to the recorded run after this long without data on the stream
JURY_SILENCE_MS=15000
# Salt for the hashed IP of the live-run limit (optional, derived from the secret key when empty)
IP_HASH_SALT=
# 3-minute demo video, shown on /jury when set
NEXT_PUBLIC_DEMO_VIDEO_URL=
